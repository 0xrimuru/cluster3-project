# LPA eComms - database settings. Copy this file to .env and fill in the values.
# .env is listed in .gitignore: real passwords must NEVER be committed to GitHub.
# `npm run db:setup` creates .env for you (with a random password for lpa_app).

# The account the web app uses (limited rights: SELECT, INSERT, UPDATE, DELETE)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lpa_ecomms
DB_USER=lpa_app
DB_PASSWORD=change-me

# Only used by `npm run db:setup` to create the database and the lpa_app account.
# XAMPP default: root with no password. Put a password that contains # in "quotes".
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# ---- MongoDB (NoSQL - sessions, activity log, product reviews) ----
# `npm run nosql:setup` fills in DATA_KEY and MONGO_URL (and MONGO_ADMIN_URL on a new server).
MONGO_HOST=127.0.0.1:27017
# Extra connection options, e.g. for TLS: tls=true&tlsCAFile=C:/mongodb/ca.pem
MONGO_OPTIONS=
# App account (least privilege) - created by nosql:setup
MONGO_URL=
# Admin account used ONLY by nosql:setup (leave empty on a fresh MongoDB install)
MONGO_ADMIN_URL=
# 32-byte AES-256 key (base64) used to encrypt personal data - created by nosql:setup
DATA_KEY=
