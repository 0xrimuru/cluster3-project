<%- include('../partials/header') %>
  <h1>Book Catalogue</h1>
  <p><a class="btn" href="/books/new">+ Add book</a></p>
  <table>
    <thead>
      <tr><th>Title</th><th>Author</th><th>Price</th><th></th></tr>
    </thead>
    <tbody>
    <% books.forEach(function (b) { %>
      <tr>
        <td><a href="/books/<%= b.id %>"><%= b.title %></a></td>
        <td><%= b.author %></td>
        <td>$<%= b.price.toFixed(2) %></td>
        <td><a href="/books/<%= b.id %>/edit">Edit</a></td>
      </tr>
    <% }); %>
    <% if (books.length === 0) { %>
      <tr><td colspan="4">No books yet &mdash; add one.</td></tr>
    <% } %>
    </tbody>
  </table>
<%- include('../partials/footer') %>
