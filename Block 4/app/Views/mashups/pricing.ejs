<%- include('../partials/header') %>
  <h1>International pricing</h1>
  <p>Mashup 2 &mdash; combines our catalogue with <strong>live exchange rates</strong> from
     Frankfurter (European Central Bank data), cross-checked against a second provider,
     open.er-api.com. Rates are cached for an hour.</p>

  <% if (!rates.primary) { %>
    <div class="card">
      <p>Sorry &mdash; the exchange-rate services can't be reached right now.
         Prices are shown in AUD only. Try again in a minute.</p>
    </div>
    <table>
      <thead><tr><th>Title</th><th>Price (AUD)</th></tr></thead>
      <tbody>
        <% books.forEach(function (b) { %>
          <tr><td><%= b.title %></td><td>$<%= b.price.toFixed(2) %></td></tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <form method="GET" action="/mashups/pricing" class="currency-picker">
      <label>Show prices in:
        <select name="currency" onchange="this.form.submit()">
          <% Object.keys(rates.currencies).forEach(function (code) { %>
            <option value="<%= code %>" <%= code === selected ? 'selected' : '' %>>
              <%= code %> — <%= rates.currencies[code] %>
            </option>
          <% }); %>
        </select>
      </label>
      <noscript><button type="submit">Update</button></noscript>
    </form>

    <% const rate = rates.primary.rates[selected]; %>
    <% const cross = rates.crosscheck && rates.crosscheck.rates[selected]; %>
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Price (AUD)</th>
          <th>Price (<%= selected %>)</th>
        </tr>
      </thead>
      <tbody>
        <% books.forEach(function (b) { %>
          <tr>
            <td><%= b.title %></td>
            <td>$<%= b.price.toFixed(2) %></td>
            <td><%= rate ? (b.price * rate).toFixed(2) + ' ' + selected : 'n/a' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <p class="rates-meta">
      1 AUD = <%= rate ? rate.toFixed(4) : 'n/a' %> <%= selected %>
      &middot; source: <%= rates.primary.provider %> (<%= rates.primary.date %>)
      <% if (cross) { %>
        &middot; cross-check: <%= cross.toFixed(4) %> via <%= rates.crosscheck.provider %>
      <% } %>
      <% if (rates.cached) { %>&middot; served from cache<% } %>
    </p>
  <% } %>
<%- include('../partials/footer') %>
