<?xml version="1.0" encoding="UTF-8"?>
<!-- LPA Administration System (desktop) - ICTPRG549 / ICTPRG547 - Pedro Alvim CTI20260187 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>au.com.lpa</groupId>
  <artifactId>lpa-desktop</artifactId>
  <version>1.0.0</version>
  <name>LPA Administration System (desktop)</name>
  <description>Java Swing desktop interface for LPA eComms: stock, clients, invoices and users on the lpa_ecomms MySQL database</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
  </properties>

  <dependencies>
    <!-- Third-party libraries -->
    <dependency> <!-- JDBC driver for MySQL / MariaDB -->
      <groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><version>9.1.0</version>
    </dependency>
    <dependency> <!-- reads config/security-policy.json (the same access policy as the web app) -->
      <groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.11.0</version>
    </dependency>
    <dependency> <!-- scrypt password hashing, compatible with the web app's hashes -->
      <groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.79</version>
    </dependency>
    <dependency> <!-- modern look and feel with light / dark themes -->
      <groupId>com.formdev</groupId><artifactId>flatlaf</artifactId><version>3.5.4</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>lpa-desktop</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
        <configuration>
          <systemPropertyVariables><java.awt.headless>${headless}</java.awt.headless></systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin> <!-- one runnable jar with all libraries:  java -jar target/lpa-desktop.jar -->
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>au.com.lpa.desktop.App</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/versions/9/module-info.class</exclude><exclude>module-info.class</exclude></excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile><id>default-headless</id><activation><activeByDefault>true</activeByDefault></activation><properties><headless>false</headless></properties></profile>
  </profiles>
</project>
