<label>Title
  <input name="title" value="<%= book.title %>" required />
</label>
<label>Author
  <input name="author" value="<%= book.author %>" required />
</label>
<label>Price (AUD)
  <input name="price" type="number" step="0.01" min="0" value="<%= book.price %>" />
</label>
<label>Description
  <textarea name="description" rows="3"><%= book.description %></textarea>
</label>
