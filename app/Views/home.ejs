<%- include('partials/header') %>
  <section class="hero">
    <h1>LPA eComms</h1>
    <p class="lede"><span id="greeting">Hello</span>, <%= user.firstName %>. Sales, stock and invoicing for Logic Peripherals Australia.</p>
  </section>
  <section class="card pad featured">
    <h2>Featured</h2>
    <video class="promo" controls preload="none" poster="/media/promo-poster.jpg" playsinline>
      <source src="/media/promo.mp4" type="video/mp4" />
      Your browser does not support embedded video.
    </video>
  </section>
  <section class="stat-grid">
    <div class="stat-tile"><span class="stat-num"><%= stats.items %></span><span class="stat-lbl">Stock items</span></div>
    <div class="stat-tile warn"><span class="stat-num"><%= stats.lowStock %></span><span class="stat-lbl">Low stock</span></div>
    <div class="stat-tile danger"><span class="stat-num"><%= stats.outStock %></span><span class="stat-lbl">Out of stock</span></div>
    <div class="stat-tile"><span class="stat-num"><%= stats.invoices %></span><span class="stat-lbl">Invoices</span></div>
    <div class="stat-tile ok"><span class="stat-num">$<%= stats.sales.toFixed(2) %></span><span class="stat-lbl">Total sales</span></div>
  </section>
  <% if (attention.length) { %>
  <section class="card pad">
    <h2>Needs attention</h2>
    <ul class="attention-list">
      <% attention.forEach(function(p){ var lv = p.quantity <= 0 ? 'out' : 'low'; %>
      <li><a href="/products/<%= p.id %>"><span class="sku"><%= p.sku %></span> <%= p.title %></a><span class="badge badge-<%= lv %>"><%= lv==='out' ? 'Out of stock' : p.quantity + ' left' %></span></li>
      <% }); %>
    </ul>
  </section>
  <% } %>
  <section class="quick-links">
    <% if (can('sales.create')) { %>
    <a class="q-card" href="/sales/new"><strong>New invoice</strong><span>Client + items, stock updates automatically</span></a>
    <a class="q-card" href="/users"><strong>Users</strong><span>Accounts, groups &amp; status</span></a>
    <% } %>
    <a class="q-card" href="/products"><strong>Stock management</strong><span>View &amp; adjust inventory</span></a>
    <a class="q-card" href="/sales"><strong>Sales &amp; invoicing</strong><span>Search invoices &amp; totals</span></a>
    <a class="q-card" href="/clients"><strong>Clients</strong><span>Customer records</span></a>
    <a class="q-card" href="/settings"><strong>Preferences</strong><span>Theme &amp; accent colour</span></a>
  </section>
<%- include('partials/footer') %>
