<%- include('partials/header') %>
  <h1>Preferences</h1>
  <section class="card pad">
    <h2>Appearance</h2>
    <fieldset class="pref-field">
      <legend>Theme</legend>
      <label class="radio-inline"><input type="radio" name="pref-theme" value="light" /> Light</label>
      <label class="radio-inline"><input type="radio" name="pref-theme" value="dark" /> Dark</label>
      <label class="radio-inline"><input type="radio" name="pref-theme" value="system" /> Match system</label>
    </fieldset>
    <fieldset class="pref-field">
      <legend>Accent colour</legend>
      <div class="swatches" id="swatches">
        <button type="button" class="swatch" data-accent="green"   style="--sw:#2d6a4f" aria-label="Green"></button>
        <button type="button" class="swatch" data-accent="blue"    style="--sw:#2563eb" aria-label="Blue"></button>
        <button type="button" class="swatch" data-accent="purple"  style="--sw:#7c3aed" aria-label="Purple"></button>
        <button type="button" class="swatch" data-accent="teal"    style="--sw:#0d9488" aria-label="Teal"></button>
        <button type="button" class="swatch" data-accent="crimson" style="--sw:#b91c1c" aria-label="Crimson"></button>
      </div>
    </fieldset>
    <p class="muted-note">Your preferences are saved on this device and applied instantly &mdash; try the theme button in the top bar too.</p>
  </section>
<%- include('partials/footer') %>
