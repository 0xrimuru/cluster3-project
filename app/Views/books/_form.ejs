<label>Stock ID (SKU)
  <input name="sku" value="<%= typeof book.sku !== 'undefined' ? book.sku : '' %>" placeholder="LPA-BK-000" />
</label>
<label>Item name
  <input name="title" value="<%= book.title %>" required maxlength="250" />
</label>
<label>Author
  <input name="author" value="<%= book.author %>" required />
</label>
<label>Category
  <input name="category" value="<%= typeof book.category !== 'undefined' ? book.category : '' %>" list="cat-list" />
  <datalist id="cat-list"><option>Software Craft</option><option>JavaScript</option><option>Algorithms</option><option>Architecture</option><option>Project Management</option><option>General</option></datalist>
</label>
<label>Price (AUD)
  <input name="price" type="number" step="0.01" min="0" value="<%= book.price %>" required />
</label>
<label>On-hand quantity
  <input name="quantity" type="number" min="0" step="1" value="<%= typeof book.quantity !== 'undefined' ? book.quantity : 0 %>" required />
</label>
<fieldset class="status-field">
  <legend>Status</legend>
  <label class="radio-inline"><input type="radio" name="status" value="active" <%= (typeof book.status==='undefined'||book.status==='active')?'checked':'' %> /> Active</label>
  <label class="radio-inline"><input type="radio" name="status" value="disabled" <%= book.status==='disabled'?'checked':'' %> /> Disabled</label>
</fieldset>
<label>Cover image URL <span class="hint">(optional)</span>
  <input name="cover" value="<%= typeof book.cover !== 'undefined' ? book.cover : '' %>" placeholder="/images/covers/placeholder.png" />
</label>
<label>Description
  <textarea name="description" rows="3"><%= book.description %></textarea>
</label>
