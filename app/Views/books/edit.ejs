<%- include('../partials/header') %>
  <h1>Stock management <span class="subtle">&mdash; edit item</span></h1>
  <form id="book-form" class="card pad" method="POST" action="/books/<%= book.id %>?_method=PUT">
    <%- include('_form', { book: book }) %>
    <div class="form-actions">
      <button class="btn" type="submit">Save</button>
      <a class="btn ghost" href="/books">Search</a>
      <a class="btn ghost" href="/books/<%= book.id %>">Close</a>
    </div>
  </form>
<%- include('../partials/footer') %>
