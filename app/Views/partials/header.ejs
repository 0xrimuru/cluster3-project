<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'OT Tech Bookstore' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <script defer src="/js/stock.js"></script>
</head>
<% var _bare = (typeof bare !== 'undefined' && bare); %>
<body class="app<%= _bare ? ' bare' : '' %>">
<% if (!_bare) { %>
  <header class="app-bar">
    <a class="app-title" href="/">OT&nbsp;Tech&nbsp;<span>Bookstore</span></a>
    <span class="app-page"><%= typeof pageName !== 'undefined' ? pageName : '' %></span>
  </header>
  <main class="app-main">
<% } %>
