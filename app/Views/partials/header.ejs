<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'LPA — Sales, Stock & Invoicing' %></title>
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>" /><% } %>
  <script nonce="<%= nonce %>">
  (function(){try{var p=JSON.parse(localStorage.getItem('lpa-prefs')||'{}');var t=p.theme||'system';
  var dark=t==='dark'||(t==='system'&&window.matchMedia&&matchMedia('(prefers-color-scheme:dark)').matches);
  var r=document.documentElement;if(dark)r.setAttribute('data-theme','dark');
  if(p.brand)r.style.setProperty('--brand',p.brand);if(p.dark)r.style.setProperty('--brand-dark',p.dark);
  }catch(e){}})();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Spline+Sans+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
  <script defer src="/js/stock.js"></script>
  <script defer src="/js/prefs.js"></script>
  <script defer src="/js/app.js"></script>
</head>
<% var _bare = (typeof bare !== 'undefined' && bare); %>
<body class="app<%= _bare ? ' bare' : '' %>">
<% if (!_bare) { %>
  <header class="app-bar">
    <a class="app-title" href="/">
      <svg class="logo" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M9 20h6M12 16v4"/></svg>
      LPA&nbsp;<span>Sales&nbsp;&amp;&nbsp;Stock</span>
    </a>
    <div class="app-tools">
      <button type="button" id="theme-toggle" class="icon-btn" aria-label="Toggle light or dark mode" title="Toggle light/dark">
        <svg class="i-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"/></svg>
      </button>
      <a class="icon-btn" href="/logout" aria-label="Log out" title="Log out">
        <svg viewBox="0 0 24 24"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"/><path d="M10 17l-5-5 5-5"/><path d="M5 12h12"/></svg>
      </a>
      <a class="icon-btn" href="/settings" aria-label="Preferences" title="Preferences">
        <svg viewBox="0 0 24 24"><path d="M4 6h8M4 12h2M4 18h12"/><path d="M20 6h-4M20 12h-8M20 18h-2"/><circle cx="14" cy="6" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="16" cy="18" r="2"/></svg>
      </a>
    </div>
  </header>
  <% if (typeof user !== 'undefined' && user) { %>
  <div class="welcome-strip">
    <span>Welcome, <strong><%= user.firstName %> <%= user.lastName %></strong></span>
    <span class="role-chip role-<%= role %>"><%= roleLabel %></span>
  </div>
  <% } %>
  <main class="app-main">
<% } %>
