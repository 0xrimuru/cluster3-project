<%# Star rating display. Pass value (0-5) and optional small: true %>
<span class="stars<%= typeof small !== 'undefined' && small ? ' sm' : '' %>" role="img" aria-label="<%= Number(value).toFixed(1) %> out of 5 stars"><span class="stars-fill" style="width:<%= Math.max(0, Math.min(100, value / 5 * 100)) %>%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
