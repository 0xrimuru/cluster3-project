<%# Review form fields. Pass f (values) %>
<fieldset class="star-pick">
  <legend>Your rating</legend>
  <div class="seg" role="radiogroup" aria-label="Rating">
    <% [1,2,3,4,5].forEach(function(n){ %>
    <input type="radio" id="<%= idp %>-r<%= n %>" name="rating" value="<%= n %>" <%= String(f.rating)===String(n)?'checked':'' %> required />
    <label for="<%= idp %>-r<%= n %>"><%= n %> &#9733;</label>
    <% }); %>
  </div>
</fieldset>
<label>Title<input name="title" value="<%= f.title || '' %>" required minlength="3" maxlength="80" /></label>
<label>Your review<textarea name="comment" rows="4" required minlength="10" maxlength="1000"><%= f.comment || '' %></textarea></label>
<label>Tags <span class="hint">(optional, up to 5, separated by commas - e.g. quiet, battery)</span><input name="tags" value="<%= Array.isArray(f.tags) ? f.tags.join(', ') : (f.tags || '') %>" maxlength="160" /></label>
