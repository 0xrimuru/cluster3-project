    <a href="/more" class="<%= _nav==='more' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/></svg><span>More</span></a>
