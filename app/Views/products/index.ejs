<%- include('../partials/header') %>
  <div class="page-head">
    <h1>Stock <span class="subtle">management</span></h1>
    <% if (role === 'administrator') { %><a class="btn" href="/products/new">+ Add item</a><% } %>
  </div>
  <form class="search-row" method="GET" action="/products" role="search">
    <input id="stock-search" name="q" type="search" class="search" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="Search by product, brand or SKU&hellip;" aria-label="Search stock" />
    <button class="btn ghost" type="submit">Search</button>
  </form>
  <p class="row-right"><a class="link" href="/stock/ledger">Audit history &rarr;</a></p>
  <ul class="stock-list" id="stock-list">
    <% products.forEach(function (p) { var lv = level(p); %>
    <li class="stock-card <%= p.status==='disabled' ? 'is-disabled' : '' %>" data-name="<%= (p.title+' '+p.brand+' '+p.sku).toLowerCase() %>">
      <a class="stock-main" href="/products/<%= p.id %>">
        <img class="cover-thumb" src="<%= p.image || '/images/products/placeholder.png' %>" alt="<%= p.title %>" />
        <div class="stock-info">
          <div class="stock-top"><span class="sku"><%= p.sku %></span><span class="cat"><%= p.category %></span></div>
          <div class="stock-title"><%= p.title %></div>
          <div class="stock-meta">$<%= p.price.toFixed(2) %> &middot; <span class="qty">Qty <%= p.quantity %></span></div>
        </div>
      </a>
      <span class="badge badge-<%= lv %>"><%= lv==='out' ? 'Out of stock' : (lv==='low' ? 'Low stock' : 'In stock') %></span>
    </li>
    <% }); %>
  </ul>
  <p id="stock-empty" class="empty-msg" style="display:none;">No items match your search.</p>
  <% if (products.length === 0) { %><p class="empty-msg">No stock items match.</p><% } %>
<%- include('../partials/footer') %>
