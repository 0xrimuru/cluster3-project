<%- include('../partials/header') %>
  <h1>Store locator</h1>
  <p>Mashup 1 &mdash; combines <strong>OpenStreetMap</strong> tiles (via the Leaflet library),
     <strong>live weather</strong> from the Open-Meteo API, and our own store data.</p>

  <link rel="stylesheet" href="/vendor/leaflet/leaflet.min.css" />
  <div id="map" class="store-map"></div>

  <div class="store-list">
    <% stores.forEach(function (s) { %>
      <div class="card store-card" id="store-<%= s.id %>">
        <h2><%= s.name %></h2>
        <p><%= s.address %></p>
        <p><%= s.phone %> &middot; <%= s.hours %></p>
        <p class="weather" data-lat="<%= s.lat %>" data-lng="<%= s.lng %>">Loading weather&hellip;</p>
      </div>
    <% }); %>
  </div>

  <script src="/vendor/leaflet/leaflet.min.js"></script>
  <script>
    // --- Source 1: OpenStreetMap tiles rendered by Leaflet ---
    const map = L.map('map').setView([-30.5, 149.0], 4); // roughly east-coast Australia
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // A short description for the Open-Meteo WMO weather codes we care about.
    function describe(code) {
      if (code === 0) return 'Clear';
      if (code <= 3) return 'Partly cloudy';
      if (code <= 48) return 'Fog';
      if (code <= 57) return 'Drizzle';
      if (code <= 67) return 'Rain';
      if (code <= 77) return 'Snow';
      if (code <= 82) return 'Showers';
      if (code <= 99) return 'Thunderstorm';
      return 'Unknown';
    }

    // --- Source 2 + 3: our own store API and the Open-Meteo weather API ---
    fetch('/mashups/api/stores')
      .then(r => r.json())
      .then(stores => stores.forEach(s => {
        const marker = L.marker([s.lat, s.lng]).addTo(map);
        marker.bindPopup('<strong>' + s.name + '</strong><br>' + s.address);

        // live weather for this store
        fetch('/mashups/api/weather?lat=' + s.lat + '&lng=' + s.lng)
          .then(r => r.json())
          .then(w => {
            const text = Math.round(w.current.temperature_2m) + '°C, ' +
                         describe(w.current.weather_code);
            marker.setPopupContent('<strong>' + s.name + '</strong><br>' + s.address +
                                   '<br>Now: ' + text);
            const el = document.querySelector('#store-' + s.id + ' .weather');
            if (el) el.textContent = 'Current weather: ' + text;
          })
          .catch(() => {
            const el = document.querySelector('#store-' + s.id + ' .weather');
            if (el) el.textContent = 'Weather unavailable right now.';
          });
      }));
  </script>
<%- include('../partials/footer') %>
