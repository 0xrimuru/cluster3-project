<%- include('../partials/header') %>
  <h1>Stock <span class="subtle">audit history</span></h1>
  <p class="row-right"><a class="link" href="/books">&larr; Back to stock</a></p>
  <ul class="ledger big">
    <% entries.forEach(function(e){ var d=e.after-e.before; %>
    <li>
      <div class="ledger-top"><strong><%= e.title %></strong> <span class="sku"><%= e.sku %></span>
        <span class="tag <%= d>=0?'up':'down' %>"><%= (d>=0?'+':'')+d %></span></div>
      <div class="ledger-sub"><em><%= e.operation %></em> &middot; <%= e.before %> &rarr; <%= e.after %> units &middot; <%= e.reason %> &middot; <%= e.user %><% if(e.at){ %> &middot; <%= e.at %><% } %></div>
    </li>
    <% }); %>
  </ul>
  <% if (entries.length===0){ %><p class="empty-msg">No adjustments yet.</p><% } %>
<%- include('../partials/footer') %>
