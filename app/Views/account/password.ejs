<%- include('../partials/header') %>
  <h1>Change password</h1>
  <% if (done) { %><div class="flash ok" role="status">Password changed. You were signed out on your other devices.</div><% } %>
  <% if (errors.length) { %><ul class="form-errors" role="alert"><% errors.forEach(function(e){ %><li><%= e %></li><% }); %></ul><% } %>
  <form class="card pad stack" method="POST" action="/account/password?_method=PUT" data-validate><%- include('../partials/csrf') %>
    <label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required /></label>
    <label>New password <span class="hint">(at least 8 characters with a letter and a number; not a common password or your user name)</span>
      <input name="newPassword" id="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label>
    <label>Confirm new password<input name="confirmPassword" id="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></label>
    <div class="form-actions"><button class="btn" type="submit">Change password</button><a class="btn ghost" href="/more">Close</a></div>
  </form>
<%- include('../partials/footer') %>
