<%- include('../partials/header') %>
  <h1>My <span class="subtle">orders</span></h1>
  <% if (!orders.length) { %>
    <section class="card pad empty-state"><p>You have not placed any orders yet.</p><a class="btn" href="/shop">Start shopping</a></section>
  <% } else { %>
  <table class="data">
    <thead><tr><th>Order</th><th>Date</th><th class="num">Items</th><th class="num">Amount</th></tr></thead>
    <tbody><% orders.forEach(function(o){ %><tr><td><a href="/orders/<%= o.number %>"><%= o.number %></a></td><td><%= o.date %></td><td class="num"><%= o.units %></td><td class="num">$<%= o.amount.toFixed(2) %></td></tr><% }); %></tbody>
    <tfoot><tr><th colspan="3">Total spent</th><th class="num">$<%= total.toFixed(2) %></th></tr></tfoot>
  </table>
  <% } %>
<%- include('../partials/footer') %>
